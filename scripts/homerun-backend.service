[Unit]
Description=Homerun home assistant backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/WorkingDirectory/EnvironmentFile to your setup.
User=pi
WorkingDirectory=/home/pi/Homerun/backend
EnvironmentFile=/home/pi/Homerun/.env
ExecStart=/home/pi/Homerun/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Camera + serial need access to the video/GPIO groups.
SupplementaryGroups=video dialout

[Install]
WantedBy=multi-user.target
