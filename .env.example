# ---- Server ----
HOMERUN_HOST=0.0.0.0
HOMERUN_PORT=8000
# Shared token required by the API/UI (set something random before remote use)
HOMERUN_AUTH_TOKEN=change-me

# ---- Arduino serial ----
# Linux: /dev/ttyACM0 or /dev/ttyUSB0 · macOS: /dev/cu.usbmodemXXXX
HOMERUN_SERIAL_PORT=/dev/ttyACM0
HOMERUN_BAUD=115200
HOMERUN_SERIAL_ENABLED=true
HOMERUN_HEARTBEAT_S=5

# ---- Storage ----
HOMERUN_DB_PATH=./data/homerun.db
HOMERUN_MEDIA_DIR=./data

# ---- Ollama ----
HOMERUN_OLLAMA_URL=http://localhost:11434
HOMERUN_OLLAMA_MODEL=llama3.2:3b
HOMERUN_OLLAMA_ENABLED=true

# ---- Camera ----
# auto | picamera | opencv | synthetic
HOMERUN_CAMERA_BACKEND=auto
HOMERUN_CAMERA_INDEX=0
HOMERUN_CAMERA_WIDTH=1280
HOMERUN_CAMERA_HEIGHT=720
# Pixel difference threshold and minimum moving area (pixels)
HOMERUN_MOTION_DIFF_THRESHOLD=25
HOMERUN_MOTION_MIN_AREA=1500
HOMERUN_MOTION_COOLDOWN_S=20

# ---- Plants ----
HOMERUN_SOIL_THRESHOLD=35
HOMERUN_SOIL_TARGET=55
HOMERUN_WATER_MAX_S=60
HOMERUN_WATER_MIN_INTERVAL_S=1800
